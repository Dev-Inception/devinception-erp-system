# Base URL of the backend REST API (note the /api suffix).
# Defaults to http://localhost:5050/api when unset.
#
# Relative path (recommended for local dev): resolves against whatever host
# loaded the page and rides the Vite dev proxy (see vite.config.ts) to the
# backend on :5050 — this is what lets a phone on the LAN or a tunnel URL
# reach the API too, not just http://localhost:5173.
VITE_API_URL=/api
