# Server
# Note: avoid 5000 on macOS — it's used by Control Center / AirPlay Receiver.
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/point_of_sale
DATABASE_SSL=false
# DATABASE_POOL_MAX=10
# SQL_LOG=false

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Password reset token lifetime (minutes)
RESET_TOKEN_EXPIRES_MIN=15

# Mail (SMTP) — e.g. Mailtrap / Gmail / SES
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
MAIL_FROM="Point of Sale <no-reply@devinception.com>"

# Linked WhatsApp numbers (Settings → Notifications → Link WhatsApp). Each
# store's login session is saved here; point it OUTSIDE the deploy folder so
# redeploying doesn't unlink every store. Default: ./storage/whatsapp-sessions
# WHATSAPP_SESSIONS_DIR=/var/lib/devinception/whatsapp-sessions
